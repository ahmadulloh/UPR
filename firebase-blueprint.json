{
  "entities": {
    "Product": {
      "title": "Mahsulot",
      "description": "Ombordagi tovar ma'lumotlari",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "unit", "price"]
    },
    "Kontragent": {
      "title": "Kontragent",
      "description": "Mijozlar va ta'minotchilar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "type": { "type": "string", "enum": ["MIJOZ", "TAMINOTCHI"] },
        "balance": { "type": "number" }
      },
      "required": ["name", "type"]
    },
    "Document": {
      "title": "Hujjat",
      "description": "Savdo yoki Xarid hujjati",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "kontragentId": { "type": "string" },
        "kontragentName": { "type": "string" },
        "rows": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "POSTED"] },
        "type": { "type": "string", "enum": ["SALE", "PURCHASE"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "KassaTransaction": {
      "title": "Kassa Amaliyoti",
      "description": "Kirim yoki chiqim amaliyoti",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sana": { "type": "string" },
        "tur": { "type": "string", "enum": ["kirim", "chiqim"] },
        "nomi": { "type": "string" },
        "summa": { "type": "number" },
        "izoh": { "type": "string" }
      }
    }
  },
  "firestore": {
    "companies/{companyId}/products": {
      "schema": "Product",
      "description": "Firma mahsulotlari"
    },
    "companies/{companyId}/kontragents": {
      "schema": "Kontragent",
      "description": "Firma kontragentlari"
    },
    "companies/{companyId}/sales": {
      "schema": "Document",
      "description": "Firma savdolari"
    },
    "companies/{companyId}/purchases": {
      "schema": "Document",
      "description": "Firma xaridlari"
    },
    "companies/{companyId}/kassa": {
      "schema": "KassaTransaction",
      "description": "Kassa amaliyotlari"
    },
    "access_control": {
       "schema": "object",
       "description": "Kirish ruxsati uchun"
    }
  }
}
